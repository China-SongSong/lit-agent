#  lit-agent 配置模板
#  用法：复制本文件为 .env，按需填写；不填的项一律用代码里的默认值。

#Agent 循环
# LIT_AGENT_MAX_ROUNDS（代码默认值：default=12）
LIT_AGENT_MAX_ROUNDS=
# LIT_AGENT_OBSERVATION_CHARS（代码默认值：default=4000）
LIT_AGENT_OBSERVATION_CHARS=

#arXiv
# LIT_ARXIV_RPS（代码默认值：default=0.33）
LIT_ARXIV_RPS=

#BM25 权重参数（改了要先想清楚再动）
# LIT_BM25_B（代码默认值：default=0.75）
LIT_BM25_B=
# LIT_BM25_K1（代码默认值：default=1.5）
LIT_BM25_K1=

#分块
# LIT_CHUNK_OVERLAP_CHARS（代码默认值：default=200）
LIT_CHUNK_OVERLAP_CHARS=

#礼貌池邮箱（公开数据源建议填真实邮箱）
# LIT_CONTACT_EMAIL（代码默认值："CROSSREF_MAILTO",
                              "OPENALEX_M）
LIT_CONTACT_EMAIL=

#Crossref
# LIT_CROSSREF_RPS（代码默认值：default=4.0）
LIT_CROSSREF_RPS=

#数据目录
# LIT_DATA_DIR（代码默认值：default=PROJECT_ROOT/"data"）
LIT_DATA_DIR=

#依赖目录
# LIT_DEPS_DIR（代码默认值：default=PROJECT_ROOT/".deps"）
LIT_DEPS_DIR=

#指纹窗口大小 n（改了老索引全废，必须重建）
# LIT_FINGERPRINT_N（代码默认值：default=7）
LIT_FINGERPRINT_N=

#HTTP 行为（超时、重试、退避）
# LIT_HTTP_BACKOFF_BASE（代码默认值：default=1.5）
LIT_HTTP_BACKOFF_BASE=
# LIT_HTTP_MAX_RETRIES（代码默认值：default=4）
LIT_HTTP_MAX_RETRIES=
# LIT_HTTP_TIMEOUT（代码默认值：default=30.0）
LIT_HTTP_TIMEOUT=

#大模型（DeepSeek）：只影响「对话」与「文章总结」
# LIT_LLM_API_KEY（代码默认值："DEEPSEEK_API_KEY","OPENAI_API_KEY"）
LIT_LLM_API_KEY=
# LIT_LLM_BASE_URL（代码默认值："DEEPSEEK_BASE_URL",
                             default="h）
LIT_LLM_BASE_URL=
# LIT_LLM_MAX_CONCURRENCY（代码默认值：default=4）
LIT_LLM_MAX_CONCURRENCY=
# LIT_LLM_MAX_INPUT_CHARS（代码默认值：default=48000）
LIT_LLM_MAX_INPUT_CHARS=
# LIT_LLM_MAX_RETRIES（代码默认值：default=3）
LIT_LLM_MAX_RETRIES=
# LIT_LLM_MODEL（代码默认值：default="deepseek-chat"）
LIT_LLM_MODEL=
# LIT_LLM_TEMPERATURE（代码默认值：default=0.2）
LIT_LLM_TEMPERATURE=
# LIT_LLM_TIMEOUT（代码默认值：default=120.0）
LIT_LLM_TIMEOUT=

#分块上限
# LIT_MAX_CHUNK_CHARS（代码默认值：default=1800）
LIT_MAX_CHUNK_CHARS=

#OpenAlex：主力数据源
# LIT_OPENALEX_RPS（代码默认值：default=8.0）
LIT_OPENALEX_RPS=

#代理
# LIT_PROXY（代码默认值："HTTPS_PROXY","https_proxy"）
LIT_PROXY=

#OpenCLI 浏览器补充源
# 未安装 OpenCLI 时自动尝试固定版本 npx；没有浏览器扩展时会自动降级
# LIT_OPENCLI_COMMAND（代码默认值：opencli）
LIT_OPENCLI_COMMAND=
# LIT_OPENCLI_PROFILE（代码默认值：空；建议填写专用浏览器 profile）
LIT_OPENCLI_PROFILE=
# LIT_OPENCLI_TIMEOUT（代码默认值：12.0）
LIT_OPENCLI_TIMEOUT=
# LIT_OPENCLI_CACHE_TTL_SECONDS（代码默认值：3600）
LIT_OPENCLI_CACHE_TTL_SECONDS=
# LIT_OPENCLI_CIRCUIT_FAILURES（代码默认值：3）
LIT_OPENCLI_CIRCUIT_FAILURES=
# LIT_OPENCLI_CIRCUIT_COOLDOWN_SECONDS（代码默认值：300）
LIT_OPENCLI_CIRCUIT_COOLDOWN_SECONDS=
# LIT_OPENCLI_MAX_CANDIDATES_PER_SITE（代码默认值：4）
LIT_OPENCLI_MAX_CANDIDATES_PER_SITE=

#RRF 融合的平滑常数 k
# LIT_RRF_K（代码默认值：default=60）
LIT_RRF_K=

#Semantic Scholar：不填也能用，填了限流更宽
# LIT_S2_API_KEY（代码默认值："SEMANTIC_SCHOLAR_API_KEY"）
LIT_S2_API_KEY=
# LIT_S2_RPS（代码默认值：default=1.0）
LIT_S2_RPS=

#网页界面端口
# LIT_STREAMLIT_PORT（代码默认值：default=8501）
LIT_STREAMLIT_PORT=

#检索默认返回条数
# LIT_TOP_K（代码默认值：default=10）
LIT_TOP_K=
